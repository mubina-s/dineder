<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".UserProfileSettingsActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- SINGLE ROOT CHILD (REQUIRED FOR SCROLLVIEW) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- 🔙 BACK BUTTON -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textAllCaps="false"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp" />

        <!-- TITLE -->
        <TextView
            android:id="@+id/tvProfileHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile Settings"
            android:textColor="@color/pink"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage your account info"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- PROFILE HEADER CARD (AVATAR + USER INFO PREVIEW) -->
        <LinearLayout
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical">

            <!-- AVATAR -->
            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/signup_photo"
                android:background="@drawable/profile_circle_bg"
                android:padding="10dp"
                android:layout_marginEnd="16dp" />

            <!-- NAME + EMAIL PREVIEW -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Name"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="email@example.com"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap Edit to change your info"
                    android:textColor="@color/pink"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account details"
            android:textColor="@color/pink"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <!-- ACCOUNT DETAILS CARD -->
        <LinearLayout
            android:id="@+id/profileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp">

            <!-- USERNAME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="@color/pink"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editUsername"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:backgroundTint="@color/pink"
                android:padding="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:hint="Enter username" />

            <!-- PASSWORD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/pink"
                android:textSize="14sp"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:backgroundTint="@color/pink"
                android:padding="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:hint="Enter password" />

            <!-- NAME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="@color/pink"
                android:textSize="14sp"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:backgroundTint="@color/pink"
                android:padding="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:hint="Enter full name" />

            <!-- EMAIL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="@color/pink"
                android:textSize="14sp"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/editEmail"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:backgroundTint="@color/pink"
                android:padding="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:inputType="textEmailAddress"
                android:hint="Enter email" />
        </LinearLayout>

        <!-- ACTIONS SECTION TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actions"
            android:textColor="@color/pink"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <!-- BUTTONS -->
        <Button
            android:id="@+id/editBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Edit"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Save Changes"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/deleteBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Delete Account"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/confirmBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Confirm Info"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp" />

    </LinearLayout>
</ScrollView>
