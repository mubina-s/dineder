<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".SavedSessionPrefsActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Back button row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:backgroundTint="@color/pink"
                android:textColor="@color/black" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvSavedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved Session Preferences"
            android:textColor="@color/pink"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSavedSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose one of your saved presets or create a new one."
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <!-- Spinner Card -->
        <LinearLayout
            android:id="@+id/spinnerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your saved presets"
                android:textColor="@color/pink"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/my_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:spinnerMode="dropdown"
                android:paddingHorizontal="8dp"
                android:gravity="center_vertical" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tip: Select a preset to view and edit its details."
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- NAME SECTION (shown/hidden in code via nameLayout) -->
        <LinearLayout
            android:id="@+id/nameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preference name"
                android:textColor="@color/pink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/preference_name_edt"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:inputType="text"
                android:hint="Enter a name like 'Date Night'"
                android:backgroundTint="@color/pink"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- RATING SECTION -->
        <LinearLayout
            android:id="@+id/ratingLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rating"
                android:textColor="@color/pink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/rating_edt"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:inputType="number"
                android:text="N/A"
                android:hint="Enter a rating from 1–5"
                android:backgroundTint="@color/pink"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- PRICE RANGE SECTION -->
        <LinearLayout
            android:id="@+id/priceRangeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Price range"
                android:textColor="@color/pink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/price_range_edt"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:inputType="text"
                android:text="N/A"
                android:hint="Enter '$', '$$', or '$$$'"
                android:backgroundTint="@color/pink"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- EDIT / SAVE BUTTON ROW -->
        <LinearLayout
            android:id="@+id/PUTLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <Button
                android:id="@+id/saved_edit_btn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Edit"
                android:backgroundTint="@color/pink"
                android:textColor="@color/black" />

            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/saved_save_changes_btn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Save Changes"
                android:backgroundTint="@color/pink"
                android:textColor="@color/black" />
        </LinearLayout>

        <!-- DELETE BUTTON -->
        <Button
            android:id="@+id/saved_delete_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="Delete"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:textAllCaps="false"
            android:visibility="gone" />

        <!-- START SESSION BUTTON -->
        <Button
            android:id="@+id/saved_createSession_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="Start this Session!"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black" />

        <!-- CREATE NEW INSTEAD BUTTON -->
        <Button
            android:id="@+id/saved_create_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Create New Instead"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black" />

    </LinearLayout>
</ScrollView>
