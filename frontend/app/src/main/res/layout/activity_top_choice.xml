<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".MainActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Here's Your Top Pick"
        android:gravity="center"
        android:textColor="@color/pink"
        android:textStyle="bold"
        android:textSize="28sp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This is the place your group liked the most!"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <!-- CARD with restaurant details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp">

        <!-- Restaurant Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurant"
            android:textColor="@color/pink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/topChoiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Website -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Website"
            android:textColor="@color/pink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/topChoiceWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Website"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:autoLink="web"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Phone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone"
            android:textColor="@color/pink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/topChoicePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:autoLink="phone"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Closing message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enjoy your meal! 🥂"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:layout_marginTop="8dp" />

</androidx.appcompat.widget.LinearLayoutCompat>
