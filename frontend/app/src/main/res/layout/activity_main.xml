<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <!-- MAIN CONTENT (toolbar + centered image + welcome text) -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/black"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            android:title="Menu"
            android:titleTextColor="@color/pink" />

        <!-- Centered image + text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <!-- center illustration -->
            <ImageView
                android:id="@+id/imgDashboard"
                android:layout_width="340dp"
                android:layout_height="340dp"
                android:src="@drawable/welcome_back"
                android:layout_marginBottom="24dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvWelcomeBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome Back"
                android:textColor="@color/pink"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="@color/pink"
                android:textSize="25sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- OVERLAY SIDE MENU (buttons float over the photo) -->
    <LinearLayout
        android:id="@+id/sideMenu"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="?attr/actionBarSize"
        android:background="@color/black"
        android:visibility="gone"
        android:elevation="50dp">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:text="HOME"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:singleLine="true"
            android:padding="4dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnProfileSettings"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:text="Profile Settings"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:singleLine="true"
            android:padding="4dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnUserHistory"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:text="My History"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:singleLine="true"
            android:padding="4dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnAppReviews"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:text="App Reviews"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:singleLine="true"
            android:padding="4dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnHostSession"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:text="Host a Session"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:singleLine="true"
            android:padding="4dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnJoinSession"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:text="Join a Session"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:singleLine="true"
            android:padding="4dp"
            android:layout_marginBottom="10dp" />

        <!-- NEW BUTTON: My History -->
        <Button
            android:id="@+id/btnRestaurants"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:text="Restaurants"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:singleLine="true"
            android:padding="4dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnDashboard"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:text="Dashboard"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:singleLine="true"
            android:padding="4dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:text="Logout"
            android:backgroundTint="@color/pink"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:singleLine="true"
            android:padding="4dp" />
    </LinearLayout>

</FrameLayout>
